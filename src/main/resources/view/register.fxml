<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.RegisterController"
      style="-fx-background-color: #f5f1eb;">

    <VBox prefWidth="520"
          spacing="25"
          alignment="CENTER_LEFT"
          styleClass="left-panel"
          style="-fx-background-color: #e7ddd1; -fx-padding: 70;">

        <Label text="Join the&#10;Community."
               styleClass="big-title"
               style="-fx-font-size: 48; -fx-font-weight: bold; -fx-text-fill: #1f1f1f;"/>

        <Label text="Create your account to access personalized courses, track your progress, and get expert guidance."
               styleClass="description"
               style="-fx-font-size: 16; -fx-text-fill: #5f5f5f; -fx-wrap-text: true;"/>

        <Label text="Your journey starts here."
               styleClass="quote"
               style="-fx-font-size: 14; -fx-font-style: italic; -fx-text-fill: #7a6f66;"/>

    </VBox>

    <StackPane HBox.hgrow="ALWAYS"
               alignment="CENTER">

        <VBox alignment="CENTER"
              spacing="18"
              styleClass="login-card"
              style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 45; -fx-max-width: 440; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 30, 0, 0, 10);">

            <Label text="Create Account"
                   style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #1f1f1f;"/>

            <Label text="Enter your details to register"
                   style="-fx-font-size: 14; -fx-text-fill: #7b7b7b; -fx-padding: 0 0 10 0;"/>

            <TextField fx:id="fullNameField"
                       promptText="Full Name"/>

            <TextField fx:id="emailField"
                       promptText="Email Address"/>

            <PasswordField fx:id="passwordField"
                           promptText="Create Password"/>

            <VBox spacing="12"
                  alignment="CENTER"
                  style="-fx-padding: 15 0 0 0;">

                <Button text="REGISTER NOW"
                        onAction="#handleRegister"
                        maxWidth="Infinity"
                        style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 14 0; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Button text="ALREADY HAVE AN ACCOUNT?"
                        onAction="#goToLogin"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #1f1f1f; -fx-border-color: #d8d0c7; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14 0; -fx-font-weight: bold; -fx-cursor: hand;"/>

            </VBox>

        </VBox>

    </StackPane>

</HBox>