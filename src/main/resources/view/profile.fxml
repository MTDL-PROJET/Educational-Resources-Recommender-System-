<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ProfileController"

      spacing="18"
      alignment="CENTER">

    <padding>
        <Insets top="40"
                right="40"
                bottom="40"
                left="40"/>
    </padding>

    <Label text="My Profile"
           style="
           -fx-font-size: 30;
           -fx-font-weight: bold;
           "/>

    <TextField fx:id="nameField"
               promptText="Full Name"/>

    <TextField fx:id="imageField"
               promptText="Profile Picture URL"/>

    <TextField fx:id="emailField"
               promptText="Email"
               editable="false"/>

    <TextField fx:id="roleField"
               promptText="Role"
               editable="false"/>

    <Button text="UPDATE PROFILE"
            onAction="#handleUpdateProfile"/>

</VBox>