<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ExpertController"
            style="-fx-background-color: #f5f1eb;">

    <center>

        <VBox spacing="25">

            <padding>
                <Insets top="40"
                        right="40"
                        bottom="40"
                        left="40"/>
            </padding>

            <VBox spacing="5">

                <Label text="Manage Content"
                       style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1f1f1f;"/>

                <Label text="Review, publish, unpublish or remove your educational materials."
                       style="-fx-font-size: 14; -fx-text-fill: #7b7b7b PapayaWhip;"/>

            </VBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 15, 0, 0, 6);"
                  VBox.vgrow="ALWAYS">

                <ListView fx:id="resourceListView"
                          style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 5;"
                          VBox.vgrow="ALWAYS"/>

            </VBox>

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <Button text="EDIT"
                        onAction="#handleEditMaterial"
                        style="-fx-background-color: #e7ddd1; -fx-text-fill: #1f1f1f; -fx-background-radius: 12; -fx-padding: 13 28; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Button text="PUBLISH"
                        onAction="#handlePublishMaterial"
                        style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 13 28; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Button text="UNPUBLISH"
                        onAction="#handleUnpublishMaterial"
                        style="-fx-background-color: transparent; -fx-text-fill: #7a6f66; -fx-border-color: #7a6f66; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 13 28; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Button text="DELETE"
                        onAction="#handleDeleteMaterial"
                        style="-fx-background-color: transparent; -fx-text-fill: #b22222; -fx-border-color: #b22222; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 13 28; -fx-font-weight: bold; -fx-cursor: hand;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>