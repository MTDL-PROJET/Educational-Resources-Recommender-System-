<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AdminController"
            fx:id="rootPane"
            style="-fx-background-color: #f5f1eb;">

    <left>

        <VBox prefWidth="250"
              spacing="15"
              style="-fx-background-color: #1f1f1f; -fx-padding: 35 20 20 20;">

            <Label text="ADMIN PANEL"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22;
                          -fx-font-weight: bold;
                          -fx-border-color: #c58c62;
                          -fx-border-width: 0 0 2 0;
                          -fx-padding: 0 0 8 0;
                          -fx-margin: 0 0 15 0;"/>

            <Button text="Pending Requests"
                    onAction="#showPendingRequests"
                    maxWidth="Infinity"/>

            <Button text="Manage Users"
                    onAction="#showUsers"
                    maxWidth="Infinity"/>

            <Button text="Platform Analytics"
                    onAction="#showAnalytics"
                    maxWidth="Infinity"
                    style="-fx-text-fill: #c58c62;"/>

            <VBox VBox.vgrow="ALWAYS"
                  alignment="BOTTOM_CENTER">

                <Button text="🌙 CINEMATIC VIEW"
                        onAction="#handleToggleCinematic"
                        maxWidth="Infinity"
                        styleClass="toggle-cinematic"/>

                <Button text="Logout"
                        onAction="#handleLogout"
                        maxWidth="Infinity"
                        style="-fx-text-fill: #ff7675;"/>

            </VBox>

        </VBox>

    </left>

    <center>

        <StackPane>

            <VBox fx:id="tableContainer"
                  spacing="25">

                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <Label fx:id="titleLabel"
                       text="Expert Requests"
                       style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1f1f1f;"/>

                <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 15, 0, 0, 6);"
                      VBox.vgrow="ALWAYS">

                    <TableView fx:id="userTableView"
                               style="-fx-background-color: transparent; -fx-background-insets: 0;"
                               VBox.vgrow="ALWAYS">

                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="80" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="nameColumn" text="Full Name" prefWidth="250"/>
                            <TableColumn fx:id="roleEmailColumn" text="Details / Role" prefWidth="300" style="-fx-alignment: CENTER_LEFT;"/>
                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>

                    </TableView>

                </VBox>

                <HBox fx:id="actionButtons"
                      spacing="15"
                      alignment="CENTER_LEFT">

                    <Button text="APPROVE USER"
                            onAction="#approveSelectedUser"
                            style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 13 28; -fx-font-weight: bold; -fx-cursor: hand;"/>

                    <Button text="DELETE USER"
                            onAction="#deleteSelectedUser"
                            style="-fx-background-color: transparent; -fx-text-fill: #b22222; -fx-border-color: #b22222; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 13 28; -fx-font-weight: bold; -fx-cursor: hand;"/>

                </HBox>

            </VBox>

            <VBox fx:id="analyticsContainer"
                  spacing="25"
                  visible="false"
                  managed="false">

                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <Label text="Platform Performance"
                       style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1f1f1f;"/>

                <HBox spacing="20" VBox.vgrow="ALWAYS">

                    <VBox spacing="10"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 15, 0, 0, 6);">

                        <Label text="User Roles Distribution" style="-fx-font-weight: bold; -fx-text-fill: #c58c62;"/>
                        <PieChart fx:id="rolePieChart" />

                    </VBox>

                    <VBox spacing="10"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 15, 0, 0, 6);">

                        <Label text="Most Viewed Resources" style="-fx-font-weight: bold; -fx-text-fill: #c58c62;"/>
                        <BarChart fx:id="resourceBarChart">
                            <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                            <yAxis><NumberAxis side="LEFT" /></yAxis>
                        </BarChart>

                    </VBox>

                </HBox>

            </VBox>

        </StackPane>

    </center>

</BorderPane>